# ID of the Google Sheet (the long string in its URL: /spreadsheets/d/<ID>/edit).
# The sheet must be shared as "Anyone with the link → Viewer".
# Leave empty to run on the built-in sample data.
GOOGLE_SHEET_ID=

# Secret for POST /api/revalidate?secret=... (forces an immediate refresh from the sheet).
REVALIDATE_SECRET=

# --- backend branch ---------------------------------------------------------
# From `npx supabase status` locally, or Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Used to build magic-link redirect URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
