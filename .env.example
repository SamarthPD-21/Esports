# showcase branch: no database and no logins. Everything is read at build time.

# Unstop registrations sheet id; defaults to the Yugaantar 2026 sheet.
# It must be shared as "Anyone with the link can view".
REGISTRATION_SHEET_ID=
# Tab gids, "codm:856659468,valorant:867069435,..." (defaults built in).
REGISTRATION_SHEET_GIDS=

# The site's path on GitHub Pages, e.g. /Esports. Leave empty locally.
PAGES_BASE_PATH=
