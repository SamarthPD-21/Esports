# ID of the Google Sheet (the long string in its URL: /spreadsheets/d/<ID>/edit).
# The sheet must be shared as "Anyone with the link → Viewer".
# Leave empty to run on the built-in sample data.
GOOGLE_SHEET_ID=

# Secret for POST /api/revalidate?secret=... (forces an immediate refresh from the sheet).
REVALIDATE_SECRET=

# --- backend branch ---------------------------------------------------------
# From `npx supabase status` locally, or Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Used to build magic-link redirect URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- registrations sync (Unstop sheet) ---------------------------------------
# Unstop registrations sheet id; defaults to the Yugaantar 2026 sheet.
REGISTRATION_SHEET_ID=
# Tab gids for the public CSV export, "codm:856659468,valorant:867069435,..." (defaults built in).
REGISTRATION_SHEET_GIDS=
# Service-account key JSON (raw or base64). If set, reads via the Sheets API and the sheet need not be public.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Bearer token for /api/sync (used by the pg_cron job in supabase/snippets/sync-cron.sql).
SYNC_SECRET=
