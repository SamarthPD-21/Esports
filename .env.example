# --- results sheet -------------------------------------------------------------
# ID of the organisers' results spreadsheet (the long string in its URL:
# /spreadsheets/d/<ID>/edit). Share it as "Anyone with the link → Viewer".
# Leave empty to preview with the sample CODM tournament and no other results.
RESULTS_SHEET_ID=

# --- registrations (Unstop sheet) ----------------------------------------------
# Unstop registrations sheet id; defaults to the Yugaantar 2026 sheet.
REGISTRATION_SHEET_ID=
# Tab gids for the public CSV export, "codm:856659468,valorant:867069435,..." (defaults built in).
REGISTRATION_SHEET_GIDS=
# Optional service-account key JSON (raw or base64). If set, registrations are read
# through the Sheets API and that sheet doesn't need to be public.
GOOGLE_SERVICE_ACCOUNT_JSON=
